# Plain settings. Every variable is in docs/configuration/environment.mdx.
APP_URL=https://assets.example.com
# Pages call the API while they render: this pod, not the gateway.
INTERNAL_URL=http://localhost:3000
# Kubernetes sets HOSTNAME to the pod's name; the server must listen on every address.
HOSTNAME=0.0.0.0

S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
S3_REGION=eu-central-1
S3_BUCKET=acme-assets
S3_FORCE_PATH_STYLE=false
# The client's address comes through the Gateway (docs/configuration/security.mdx).
TRUSTED_PROXIES=private
# Where browsers upload to, when the pod reaches storage at an in-cluster
# address (http://seaweedfs.storage:8333). Unset: S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=https://s3.assets.example.com

# SIGNUP=invite
# RATE_LIMIT=1200
