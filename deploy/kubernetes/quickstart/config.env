# The port-forwards in kustomization.yaml: the app at localhost:3000, storage
# at localhost:9000. Every variable is in docs/configuration/environment.mdx.
APP_URL=http://localhost:3000
INTERNAL_URL=http://localhost:3000
# Kubernetes sets HOSTNAME to the pod's name; the server must listen on every address.
HOSTNAME=0.0.0.0

# The pod reaches storage by its Service; browsers through the port-forward.
S3_ENDPOINT=http://s3:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=artbucket
S3_FORCE_PATH_STYLE=true
