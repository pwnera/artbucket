# Copy to secret.env (git ignores it) and fill in. It becomes the Secret
# artbucket-secret; for a secrets manager, see docs/installation/kubernetes.mdx.
DATABASE_URL=postgres://artbucket:password@postgres.example.com:5432/artbucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# openssl rand -base64 32. It signs sessions and encrypts secrets stored in
# settings: keep it, since a new one signs everyone out.
BETTER_AUTH_SECRET=
# OIDC_CLIENT_SECRET=
# EMAIL_API_KEY=
