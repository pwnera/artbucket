    {
      "key": "logo.primary",
      "label": "The logo",
      "type": "text",
      "value": "The logo: the orbit mark and the word **blender**, always together, in their original colors.",
      "usage": "Use it to credit Blender or link to blender.org, as a secondary brand beside your own. It is a registered trademark of the Blender Foundation.",
      "assets": [
        "9dfd7f8b-0e2a-41f3-adf3-f76ffdeac98c"
      ]
    },
    {
      "key": "logo.reversed",
      "label": "On dark",
      "type": "text",
      "value": "The whole logo in white, for dark grounds and photography.",
      "assets": [
        "a9d35125-be08-4ea8-98a9-22f2758bc973"
      ]
    },
    {
      "key": "logo.mark",
      "label": "The mark",
      "type": "text",
      "value": "The orbit mark alone: for app icons and favicons, where the word would not read.",
      "assets": [
        "37819fb6-d190-468d-9c87-4809fcc6cbbd"
      ]
    },
    {
      "key": "logo.badge",
      "label": "Community badge",
      "type": "text",
      "value": "The community badge, for events, meetups and add-ons made by the community.",
      "assets": [
        "049bd40b-fccb-4772-91ec-3f68c192dcc2"
      ]
    },
    {
      "key": "logo.always",
      "label": "Always",
      "type": "list",
      "value": [
        "Use it unaltered, in its original colors",
        "Keep the mark and the word together",
        "Keep your own brand more prominent than Blender's",
        "Link it to blender.org"
      ]
    },
    {
      "key": "logo.never",
      "label": "Never",
      "type": "list",
      "value": [
        "Recolor, redraw or retype the word",
        "Use it as your product's or company's own logo",
        "Use it alone outside a group of logos",
        "Imply the Blender Foundation endorses you"
      ]
    },
    {
      "key": "tone.voice",
      "label": "Voice",
      "type": "text",
      "value": "Plain, confident and generous. Blender speaks like an artist who is glad to share: free to use for any purpose, forever, made by a community for everyone."
    },
    {
      "key": "tone.always",
      "label": "We always",
      "type": "list",
      "value": [
        "Say free, and mean it: free as in freedom",
        "Credit the community and the artists by name",
        "Show the work, then talk about the tool",
        "Keep sentences short and verbs active"
      ]
    },
    {
      "key": "tone.avoid",
      "label": "We avoid",
      "type": "list",
      "value": [
        "Marketing superlatives",
        "Talking down to beginners",
        "Calling it a product or a service",
        "Hiding the license"
      ]
    },
    {
      "key": "brand.tagline",
      "label": "Tagline",
      "type": "text",
      "value": "The Freedom to Create",
      "spec": {
        "max": 30,
        "copy": true
      }
    },
    {
      "key": "brand.mission",
      "label": "Boilerplate",
      "type": "text",
      "value": "Blender is the free and open source 3D creation suite. Free to use for any purpose, forever.",
      "spec": {
        "max": 140,
        "copy": true
      }
    },
    {
      "key": "brand.credit",
      "label": "Credit line",
      "type": "text",
      "value": "Made with Blender",
      "spec": {
        "max": 20,
        "copy": true
      },
      "usage": "In film and game credits, type it out rather than placing the logo."
    },
    {
      "key": "imagery.openMovies",
