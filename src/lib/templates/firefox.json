  "rules": [
    { "key": "color.primary", "label": "Orange 50", "type": "color", "value": "#ff7139", "spec": { "pair": "color.ink", "group": "Logo", "tints": [80, 60, 40, 20], "token": "Orange 50", "weight": 22 }, "usage": "The fox's fur and Firefox's signature. Calls to action, highlights, the first color in any set. Carries Ink text, never white." },
    { "key": "color.yellow", "label": "Yellow 40", "type": "color", "value": "#ffbd4f", "spec": { "pair": "color.ink", "group": "Logo", "token": "Yellow 40", "weight": 8 }, "usage": "The light side of the fox: the gradient's bright start." },
    { "key": "color.red", "label": "Red 50", "type": "color", "value": "#ff4f5e", "spec": { "pair": "color.ink", "group": "Logo", "token": "Red 50", "weight": 6 }, "usage": "The warm gradient's middle. Emphasis and alerts." },
    { "key": "color.pink", "label": "Pink 60", "type": "color", "value": "#e31587", "spec": { "pair": "color.white", "group": "Logo", "token": "Pink 60", "weight": 5 }, "usage": "Where the fox's tail turns to magenta." },
    { "key": "color.violet", "label": "Violet 50", "type": "color", "value": "#9059ff", "spec": { "pair": "color.white", "group": "Logo", "token": "Violet 50", "weight": 9 }, "usage": "The globe's violet: the cool side of the brand, for depth and night scenes." },
    { "key": "color.blue", "label": "Blue 50", "type": "color", "value": "#0060df", "spec": { "pair": "color.white", "group": "Interface", "token": "Blue 50", "weight": 5 }, "usage": "Links and interface actions, as in the browser itself." },
    { "key": "color.green", "label": "Green 50", "type": "color", "value": "#3fe1b0", "spec": { "pair": "color.ink", "group": "Interface", "token": "Green 50", "weight": 3 }, "usage": "Success and privacy protections turning on." },
    { "key": "color.ink", "label": "Ink 80", "type": "color", "value": "#20123a", "spec": { "pair": "color.white", "group": "Neutrals", "token": "Ink 80", "weight": 22 }, "usage": "Headings, text and the dark ground. A deep violet, never pure black." },
    { "key": "color.gray", "label": "Marketing Gray 80", "type": "color", "value": "#42425a", "spec": { "pair": "color.white", "group": "Neutrals", "token": "Marketing Gray 80", "weight": 6 }, "usage": "Body text and secondary copy." },
    { "key": "color.background", "label": "Light Gray 10", "type": "color", "value": "#f9f9fb", "spec": { "pair": "color.ink", "group": "Neutrals", "token": "Light Gray 10", "weight": 12 }, "usage": "The light ground of Firefox pages." },
    { "key": "color.white", "label": "White", "type": "color", "value": "#ffffff", "spec": { "group": "Neutrals", "weight": 2 } },
    { "key": "color.warm", "label": "Warm gradient", "type": "color", "value": "#ff7139", "spec": { "group": "Gradients", "gradient": { "kind": "linear", "angle": 45, "stops": [{ "at": 0, "color": "#f5156c" }, { "at": 25, "color": "#ff3750" }, { "at": 50, "color": "color.red" }, { "at": 75, "color": "color.primary" }, { "at": 100, "color": "#ff980e" }] } }, "usage": "The fox's fire, from magenta to amber. Hero bands and big moments; the solid is Orange 50 where a gradient can't go." },
    { "key": "color.cool", "label": "Cool gradient", "type": "color", "value": "#9059ff", "spec": { "group": "Gradients", "gradient": { "kind": "linear", "angle": 90, "stops": [{ "at": 0, "color": "#3a8ee6" }, { "at": 50, "color": "color.violet" }, { "at": 100, "color": "#c139e6" }] } }, "usage": "The globe, from blue through violet to purple. Night, depth and product moments; the solid is Violet 50." },
    { "key": "type.heading", "label": "Headings", "type": "font", "value": { "family": "Metropolis", "weight": 700 }, "spec": { "role": "headline", "source": "files", "license": "SIL Open Font License 1.1, Chris Simpson", "fallback": "Inter, system-ui, sans-serif", "tracking": -0.01 }, "usage": "Metropolis, a geometric sans, for Firefox headings and buttons. Not on Google Fonts: the files are here.", "assets": ["08af6db9-e0d5-4b7a-ba06-0e7fd6a0d840", "b8dea423-2c98-4cea-9a98-1a2d039cc266"] },
    { "key": "type.body", "label": "Text", "type": "font", "value": { "family": "Inter", "weight": 400 }, "spec": { "role": "body", "source": "google", "license": "SIL Open Font License 1.1", "fallback": "system-ui, sans-serif", "lineHeight": 1.6 }, "usage": "Inter for everything read." },
    { "key": "logo.primary", "label": "The lockup", "type": "text", "value": "The horizontal lockup: the fox and globe beside the word **Firefox**. The default everywhere there is room.", "usage": "A Mozilla trademark. Use it to refer to Firefox, unmodified, never as your own mark.", "assets": ["87f54351-26e5-4edc-b78f-2b08ff56315e"] },
    { "key": "logo.reversed", "label": "On dark", "type": "text", "value": "The lockup with a white word, for Ink and photography.", "assets": ["fbfb96be-88ea-4be8-868c-a0b95ce5cfbe"] },
    { "key": "logo.vertical", "label": "Vertical", "type": "text", "value": "The fox stacked over the word, for square spaces.", "assets": ["45a62e18-be41-4af6-ad85-42e44576244d"] },
    { "key": "logo.mark", "label": "The logo", "type": "text", "value": "The fox and globe alone: app icons, favicons, and anywhere the word already appears.", "assets": ["d064ec35-c47f-40d5-8a69-7a14d9771b5f"] },
    { "key": "logo.mono", "label": "One color", "type": "text", "value": "One color, for single-ink print and embossing.", "assets": ["ff1bce5f-925a-40e3-9e7a-e94c5a158951", "d6c795d9-8e38-4459-8ca2-1f5a20b90a0b"] },
    { "key": "logo.parent", "label": "Parent brand", "type": "text", "value": "The Firefox parent brand: the abstract flame that stands for the whole family of products, not the browser.", "assets": ["ac28f817-3406-4e71-9b08-c01061787126"] },
    { "key": "logo.mozilla", "label": "Mozilla", "type": "text", "value": "Mozilla, the maker, as the endorser: **Firefox by Mozilla**.", "assets": ["543847a6-eaa6-4502-adad-cb155ec3cf7a"] },
    { "key": "logo.clearSpace", "label": "Clear space", "type": "number", "value": 1, "spec": { "of": "the x-height of the word", "unit": "x" }, "usage": "Around the lockup, at least the height of the lowercase x in Firefox. Around the logo alone, a quarter of its width." },
    { "key": "logo.minSize", "label": "Smallest on screen", "type": "number", "value": 20, "spec": { "unit": "px" }, "usage": "The logo's height; 3.8 mm in print." },
    { "key": "logo.always", "label": "Always", "type": "list", "value": ["Use the files as they are", "Keep the fox and globe whole", "Give it clear space", "Refer to Firefox, truthfully"] },
    { "key": "logo.never", "label": "Never", "type": "list", "value": ["Recolor, rotate or redraw it", "Separate the fox from the globe", "Put anything on top of it", "Combine it with your own name or mark", "Imply Mozilla endorses you"] },
    { "key": "brand.name", "label": "The name", "type": "text", "value": "Firefox", "spec": { "max": 7, "copy": true }, "usage": "One word, capital F. **Firefox by Mozilla** when the maker matters. Never FireFox, Fire Fox or FF." },
    { "key": "brand.mission", "label": "Why it exists", "type": "text", "value": "The internet is a global public resource that must remain open and accessible to all.", "spec": { "max": 120, "copy": true }, "usage": "From the Mozilla Manifesto: the reason Firefox is made." },
    { "key": "tone.voice", "label": "Voice", "type": "text", "value": "A trusted guide. Firefox shares its point of view with calm confidence and never dictates it: it doesn't oversell, doesn't use fear, and is for something rather than against something." },
    { "key": "tone.pillars", "label": "Four pillars", "type": "list", "value": ["Opinionated", "Encouraging", "Values-driven", "Sincere"] },
    { "key": "tone.always", "label": "Always", "type": "list", "value": ["Take a clear point of view", "Encourage people to take control", "Say what Firefox stands for", "Match the moment: neutral for tasks, warm for celebrations"] },
    { "key": "tone.avoid", "label": "Avoid", "type": "list", "value": ["Overselling", "Fear tactics about privacy", "Defining ourselves against others", "Jargon people have to look up"] },
    { "key": "imagery.product", "label": "Product", "type": "text", "value": "The browser as people see it: new tab, desktop and phone, in light and dark.", "assets": ["e40d315a-8a2e-4b51-91ff-f8d37ae8cc4a", "88870289-69c3-48d5-973f-e696ad59caf1", "a76ecf42-2169-4c90-b8b5-db5f3c74ab18", "ffd37348-bfbd-40cb-9b11-12c2294ac484", "cb2b6180-a882-4138-b746-5364bde231c1", "3950a895-06d4-4784-a068-c4e0a6989ebb"] },
    { "key": "imagery.community", "label": "Community", "type": "text", "value": "Twenty years of Firefox, drawn by the people who use it.", "assets": ["197fa1d3-cd00-44ec-b108-045bf2f82cbe", "890d439b-ee26-4f27-85ae-6fd7c7171969"] }
  ],
