    { "key": "logo.primary", "label": "The logo", "type": "text", "value": "The R in a gear: the Rust logo, black on light grounds.", "usage": "Artwork CC BY 4.0, and a registered trademark of the Rust Foundation. Most non-commercial uses are fine; commercial use and merchandise need written permission.", "assets": ["a428e1a6-25c0-405d-9bda-39e17b4d3861"] },
    { "key": "logo.reversed", "label": "On dark", "type": "text", "value": "Outlined in white, for dark grounds.", "assets": ["8c628268-a628-4a40-8be4-afeb597d351a"] },
    { "key": "logo.mark", "label": "The gear", "type": "text", "value": "The gear alone, for decoration and small marks.", "assets": ["9992e494-daa6-4275-a120-3e915e3e72ff"] },
    { "key": "logo.rainbow", "label": "Rainbow", "type": "text", "value": "The rainbow logo, for Pride and inclusion work.", "assets": ["1aa5b18d-87fd-47c0-9588-24f80f42d9f5"] },
    { "key": "logo.rusty", "label": "Rusty", "type": "text", "value": "The textured, rusty logo: illustration, stickers, posters.", "assets": ["970f6d0c-7147-42d4-81c7-269b04792c32"] },
    { "key": "logo.always", "label": "Always", "type": "list", "value": ["Use it to refer to Rust", "Say so when you have modified it", "Ask trademark@rust-lang.org before selling anything with it"] },
    { "key": "logo.never", "label": "Never", "type": "list", "value": ["Make your project look official", "Imply the Rust Foundation endorses you", "Put it on merchandise without permission"] },
    { "key": "brand.name", "label": "The name", "type": "text", "value": "Rust", "spec": { "max": 4, "copy": true }, "usage": "One word, capital R: **Rust**, never RUST. Its people are **Rustaceans**." },
    { "key": "brand.tagline", "label": "Tagline", "type": "text", "value": "A language empowering everyone to build reliable and efficient software.", "spec": { "max": 80, "copy": true } },
    { "key": "tone.voice", "label": "Voice", "type": "text", "value": "Inclusive, earnest and precise. Rust explains the hard parts patiently, welcomes beginners as peers, and is exact about what the compiler promises." },
    { "key": "tone.always", "label": "We always", "type": "list", "value": ["Welcome everyone, whatever they know", "Be exact: say what is guaranteed and what is not", "Show code that compiles", "Credit the teams and contributors"] },
    { "key": "tone.avoid", "label": "We avoid", "type": "list", "value": ["Language wars", "Blaming people for bugs", "Rewrite-it-in-Rust evangelism", "Absolutes the compiler does not back"] },
    { "key": "mascot.ferris", "label": "Ferris", "type": "text", "value": "Ferris the crab, the unofficial mascot of Rust and its community. Public domain: use him freely, recolor him, dress him up.", "usage": "CC0, drawn by Karen Rustad Tölva (rustacean.net).", "assets": ["d096deee-920a-4e23-88e8-08ca68f9f454", "63740006-885a-491a-9362-bd6792ef02a8", "0a9a9cef-1146-4439-9a23-d8388c7bb326", "fb93fe34-c5e1-4683-a68a-f09d7d69ff96"] },
