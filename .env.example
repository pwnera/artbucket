# Postgres
DATABASE_URL=postgres://artbucket:artbucket@localhost:5433/artbucket
# The bundled Postgres's password (docker-compose.yml); change DATABASE_URL to match.
# POSTGRES_PASSWORD=artbucket

# S3-compatible storage (MinIO locally, S3 / R2 / B2 in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=artbucket
S3_ACCESS_KEY_ID=artbucket
S3_SECRET_ACCESS_KEY=artbucket
# MinIO and most non-AWS providers need path-style addressing
S3_FORCE_PATH_STYLE=true
# Where browsers reach storage, when the server reaches it elsewhere (Docker
# Compose sets it: the app uses http://s3:9000). Unset: S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=https://s3.example.com

# Public origin, used to build rendition URLs
APP_URL=http://localhost:3000
# Where the server reaches itself when rendering pages, when it can't reach
# APP_URL from inside (a container behind a proxy). Unset: APP_URL.
# INTERNAL_URL=http://localhost:3000
# What organizations' own domains should CNAME to, shown beside their TXT
# record. Unset: "point it at this server".
# DOMAIN_TARGET=assets.example.com

# A domain whose subdomains are portals: {slug}.PORTAL_DOMAIN, beside /p/{slug}.
# Needs a wildcard DNS record and certificate. Unset: /p/{slug} only.
# PORTAL_DOMAIN=portals.example.com

# BrandHub: brands their owners list, public, for people and agents.
# A host of its own, or a path on APP_URL's. Unset: no hub.
# HUB_URL=http://localhost:3000/hub

# Signs sessions. Required in production: openssl rand -base64 32
# BETTER_AUTH_SECRET=

# Single sign-on with any OpenID Connect provider (all three, or none). Its
# redirect URI is {APP_URL}/api/auth/callback/oidc
# OIDC_ISSUER=https://accounts.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=SSO

# "Continue with Google" (both, or neither). Its redirect URI is
# {APP_URL}/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# A check on making an account with a password. Off unless set; see
# docs/configuration/auth.mdx. Cloudflare Turnstile at APP_URL (both, or
# neither), a built-in proof of work on organizations' own domains:
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Or the proof of work everywhere, without Turnstile:
# SIGNUP_CAPTCHA=pow

# Email for every organization that doesn't set its own in Settings. Off unless
# set. Providers: resend, postmark, sendgrid, console (prints to the log).
# EMAIL_PROVIDER=resend
# EMAIL_FROM="Artbucket <assets@example.com>"
# EMAIL_REPLY_TO=
# EMAIL_API_KEY=

# What a request without an API key or a session may do: none, read, propose,
# write, admin. Unset: nothing. Before the first account exists, nothing works
# at all: the app asks for that account first.
# ANONYMOUS_SCOPE=

# Who may make an account: invite (the default) or open, where anyone can and
# gets an organization of their own.
# SIGNUP=invite

# /api requests per minute per client; 0 turns the limit off.
# RATE_LIMIT=1200

# Limits for every organization; unset is unlimited. One organization's own go
# in the database (see docs/configuration/limits.mdx). Sizes read 10GB, 500MB.
# LIMIT_STORAGE=10GB
# LIMIT_EDITORS=5
# LIMIT_WORKSPACES=3
# LIMIT_BRANDS=5
# Features on (agents, shares, sso), comma-separated, or none. Unset: all.
# LIMIT_FEATURES=agents,shares
# Per person: organizations without a plan (no limits row) they may be admin of and still make another.
# LIMIT_ORGANIZATIONS=1

# The server's brand, for every organization that hasn't set its own in
# Settings, Branding (docs: configuration/white-labeling).
# BRAND_NAME=Acme Assets
# BRAND_TAGLINE=Everything Acme, approved.
# BRAND_ACCENT=#0a9396
