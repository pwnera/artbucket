# Postgres
DATABASE_URL=postgres://artbucket:artbucket@localhost:5433/artbucket

# S3-compatible storage (MinIO locally, S3 / R2 / B2 in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=artbucket
S3_ACCESS_KEY_ID=artbucket
S3_SECRET_ACCESS_KEY=artbucket
# MinIO and most non-AWS providers need path-style addressing
S3_FORCE_PATH_STYLE=true

# Public origin, used to build rendition URLs
APP_URL=http://localhost:3000

# What a request without an API key may do: none, read, propose, write, admin.
# admin (the default) suits a single user on localhost. Exposing the app? Mint
# keys first (POST /api/v1/keys), then lower this to read or none.
# ANONYMOUS_SCOPE=admin
